static const FKAPVoLine GKAPVoLines[] = {
	{ TEXT("...ш-ш-ш... QazUran кенішінде апат... жерасты ұңғымаларының бірнешеуі істен шықты..."), false },
	{ TEXT("...жұмысшылардың арасында сәулеленгендер бар... барлық жөндеуші-инженерлер №1 ұңғымаға..."), false },
	{ TEXT("...ауа райы ескертуі... оңтүстік-батыстан құм дауы... ш-ш-ш..."), false },
	{ TEXT("Тағы да қызып кетті ме? Шыда, Буханка, аз қалды..."), false },
	{ TEXT("Радиатор қайнап кетті... Енді жаяу қалдым."), false },
	{ TEXT("Анау не?.. Құм дауылы! Тез баспана табу керек!"), false },
	{ TEXT("KAP Simulator"), false },
	{ TEXT("Баспана табыңыз"), false },
	{ TEXT("Соңғы күні №3 ұңғымада қышқыл қайта ағып кетті. Ерлан Сейітов клапанды жабу үшін ішке кірді. Басқаларды құтқарды... өзі оралмады."), false },
	{ TEXT("Ерлан Сейітов, 19 жас. Сәулеленуден қайтыс болды."), false },
	{ TEXT("Балам... Ерлан... құлыным менің..."), true },
	{ TEXT("Оқуыңды бітіремін деп едің ғой... Қайтып келемін деп едің ғой..."), true },
	{ TEXT("Балам-ау... жалғызым-ау..."), true },
	{ TEXT("«Қашу». Аймақ ерте жабылды."), false },
	{ TEXT("«Қашу». Мутация таралуы 100%-ға жетті."), false },
	{ TEXT("Аймақ жабылды. Артта — жанып жатқан дала."), false },
	{ TEXT("Біз оларды құтқара алмадық..."), false },
	{ TEXT("«Құтқару». Ұңғымалар қалпына келді, мутация тоқтады."), false },
	{ TEXT("Кеніш қайта жұмыс істеп тұр. Тірі қалған жұмысшылар отбасыларына оралады."), false },
	{ TEXT("Бірақ бәрі бірдей оралған жоқ..."), false },
	{ TEXT("Сорғы қайта жұмыс істеп тұр. Енді күзетпен сөйлесейін."), false },
	{ TEXT("Планшет қосылды. QazUran кеніш желісіне қосылу..."), true },
	{ TEXT("Ескі, бірақ жарамды. Енді Буханкаға."), false },
	{ TEXT("Осы жерде күте тұрайын. Үстелде бір нәрсе жатыр..."), false },
	{ TEXT("Сорғы тоқтаған. Бөлшек вагондағы жәшікте болуы керек еді... Пульттен бастайын."), false },
	{ TEXT("Басқарма бос... Құжаттар кеңседе болуы керек."), false },
	{ TEXT("14 маусым. Шығымды арттыру үшін ерітіндідегі қышқыл концентрациясы нормадан 40%-ға көтерілді. Бұйрық — басқармадан.\n21 маусым. №7, №13 ұңғымаларда қысым датчиктері ескерту берді. Тексеру «жоспар орындалғанша» кейінге қалдырылды.\n2 шілде. Бақылау ұңғымасының қаптамасы жарылды. Ерітінді жерасты горизонтынан тыс шықты. Хабарлау тоқтатылды.\n3 шілде. Апат. Басшылық эвакуацияланды. Жұмысшыларға хабарланбады.\n\nСебеп анық: ескертулер еленбеді, адамдардың өмірі жоспардан төмен қойылды."), false },
