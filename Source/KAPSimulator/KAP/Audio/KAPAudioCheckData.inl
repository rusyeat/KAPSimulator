	{ TEXT("Планшет: дауыл 1 сағаттан кейін басылады. Вагоннан шықпаңыз."), true },
	{ TEXT("Дауыл басылды. Буханкаға радиатор керек — 60 м жердегі ескі көлік қаңқасын тексеріңіз."), false },
	{ TEXT("Кеніш: су қоймасының сорғысы істен шықты. Жөндесеңіз — су тасушы көлік беріледі."), false },
	{ TEXT("Сен жаңа инженерсің бе? №1-ді жөндедің — көрдім. Жарайсың.\nЖағдай нашар: даланы мутанттар мен бандиттер басып алды. Қарусыз жүру — өлім.\nМә, қару рұқсатын планшетіңе жаздым. Мына ПМ-ді ал. Бірақ ауылдарда абай бол — жасақтар сенімсіз адамды ұнатпайды."), false },
	{ TEXT("Жиырма бір ұңғыма, бәрі планшетте. Байқа: бұзылған ұңғыма уақыт өте нашарлайды — алдымен ағу, сосын өрт. Ағып жатқан жерде жұмысшылар сәулеленеді.\nБасқа аймақтарды көру үшін сигнал мұнараларын қос. Бес ұңғыманы жөндесең, басқармаға кіру рұқсатын аласың.\nАқсайдағы Төлеген ақсақалға соқ — ол көмектеседі."), false },
	{ TEXT("Басқармаға рұқсатың бар. Апаттың себебін анықта — бәріміз соны күтеміз."), false },
	{ TEXT("Түнде мутант қасқырлар ауылға жақындап жүр. Жігіттеріміз шаршады. Ауыл маңындағы алтауын жойсаң, сені өз адамымыз деп танимыз."), false },
	{ TEXT("Қаражардың солтүстік-батысында лагерь құрған. Жолда тонайды, ұңғымалардан бөлшек ұрлайды. Олар топпен шабуылдайды, жасырынады — абай бол."), false },
	{ TEXT("Сенімен сөйлесетін ештеңем жоқ."), false },
	{ TEXT("Қош келдің, балам. Ауыл саған қарыздар."), false },
	{ TEXT("Ассалаумағалейкум, инженер. Біздің Ерлан да сол кеніште, №3-те істейді... Анасы күнде жолға қарайды."), false },
	{ TEXT("Нұрлан Есенов кеше мотоциклмен оңтүстіктегі құмды төбелерге кетіп, қайтпады. Сондай жерде мутант құрттар бар..."), false },
	{ TEXT("Иә, бірақ бөлшектері жоқ. Төрт бөлшек дала бойына шашылып қалды — бандиттер тонаған. Тапсаң, Нива сенікі."), false },
	{ TEXT("Жосалыға қош келдің. Ауыл аман, бірақ қашанғы?.."), false },
	{ TEXT("Біздің Нұрлан Есенов оңтүстіктегі құмды төбелерге кетіп жоғалды. Тапсаңыз екен..."), false },
	{ TEXT("Құдайға шүкір, адам келді! Аяғым жараланған, мотоцикл сынып қалды... Жосалыға жеткізіп салыңызшы."), false },
	{ TEXT("Мен соңыңыздамын."), false },
	{ TEXT("Сіз... шын адамсыз ба? Біз осы қирандының ішінде үш күн жасырындық. Анау алып... түнде келеді."), false },
	{ TEXT("Ағай, біз сіздің жағыңыздамыз. Мутанттарды көрсеңіз, айғайлаңыз."), false },
	{ TEXT("Ауылда тәртіп сақта. Мутанттар көбейіп барады."), false },
	{ TEXT("Тоқта! Қаруың болса — рұқсатың бар ма? Рұқсатсыз қару ұстасаң, оқ атамыз."), false },
	{ TEXT("Өтіңіз, инженер. Кеңсе сол жақта."), false },
	{ TEXT("Басқармаға кіру тек рұқсатпен. Күзет бастығы Бекзатқа барыңыз."), false },
	{ TEXT("Су таусылып барады... Ұңғымалар тоқтаса, ауыл да өледі."), false },
	{ TEXT("Түнде даладан біртүрлі ұлыған дауыс естіледі."), false },
	{ TEXT("Балам кеніште істейді. Оны көрсеңіз, сәлем айтыңыз."), false },
	{ TEXT("Бұрын дала тыныш еді..."), false },
	{ TEXT("Дауыл кезінде үйден шықпаңыз — олар дыбысқа келеді."), false },
	{ TEXT("Бүгін тағы әлсіз болып тұрмын... Анам дәрігер келеді деді. Терезеден достарымның ойнап жүргенін көріп отырмын."), false },
	{ TEXT("Біз осы ауылда тұрамыз. Інім бүгін сыртқа шыға алмады. Тезірек жазылса екен..."), true },
	{ TEXT("Ауылдан алысқа баруға болмайды дейді. Ағалар ұңғымаларды жөндеп болғанда, далада еркін ойнаймыз ба?"), false },
	{ TEXT("Ақсайда тәртіп біздің мойнымызда. Бандиттер жолдарды тонап жүр, мутанттар ауылға жақындады. Көмектессең — ақысын төлейміз."), false },
	{ TEXT("Ақсайда тәртіп біздің мойнымызда. Қару рұқсатың жоқ екен — оны кеніш күзетінен ал. Ал жұмысқа қазір де келісемін."), false },
	{ TEXT("Ассалаумағалейкум! Қару, оқ-дәрі, дәрі-дәрмек — бәрі бар. Сынық металл әкелсең, сатып аламын. Жүк тасуға адам да керек."), false },
	{ TEXT("Қош келдің. Аймаққа кіруге рұқсатың бар. Қоймадан қару алуға болады, жұмыс та табылады."), false },
	{ TEXT("Тоқта. Бұл — әскери аймақ, бөгде адамға кіруге болмайды. Бірақ бізге сенімді адам керек: бір тапсырманы орында — рұқсат аласың."), false },
	{ TEXT("Басым айналып тұр... Су бар ма?"), false },
	{ TEXT("Демім жетпей жатыр..."), false },
	{ TEXT("Дәрігер шақырыңызшы..."), false },
	{ TEXT("Инженер! Ұңғыма істен шықты, тез жөндеңіз!"), false },
	{ TEXT("Қысым түсіп кетті, сорғы тұрып қалды!"), false },
	{ TEXT("Ағып кетсе бәріміз сәулеленеміз!"), false },
	{ TEXT("Пульт анау жақта, көмектесіңіз!"), false },
	{ TEXT("Сәлем, инженер. Бәрі қалыпты."), false },
	{ TEXT("Сорғы тынбай жұмыс істеп тұр."), false },
	{ TEXT("Түнде даладан біртүрлі дыбыстар шығады..."), false },
	{ TEXT("Ауылға қашан қайтамыз, білмеймін."), false },
	{ TEXT("Сіз келгелі сәл жеңілдеді."), false },
	{ TEXT("Дозиметрге қарап жүріңіз."), false },
	{ TEXT("Клапанды тартып жатырмын, сәл күте тұрыңыз."), false },
	{ TEXT("Қысым тағы да секірді..."), false },
	{ TEXT("Мына бұранда тот басып қалған."), false },
	{ TEXT("Жәшікті вагонға апарып тастайын."), false },
	{ TEXT("Ассалаумағалейкум!"), false },
	{ TEXT("Су таусылып барады..."), false },
	{ TEXT("Балалар үйден шықпайды, қорқады."), false },
	{ TEXT("Кеніштегілерге сәлем айтыңыз."), false },
	{ TEXT("Түнде қасқырлар ұлиды..."), false },
	{ TEXT("Келші, балам, сөйлесейік."), false },
	{ TEXT("Бұл далада бұрын тыныш еді..."), false },
	{ TEXT("Жігіттерге көмек керек."), false },
	{ TEXT("Түн ұзақ болады..."), false },
	{ TEXT("Отты өшірмеңдер, ол жарықтан қорқады."), false },
	{ TEXT("Атам айтушы еді: далада жалғыз жүрме деп."), false },
	{ TEXT("Қашыңдар! Мұнда бір нәрсе бар!"), false },
	{ TEXT("Көмектесіңдер!"), false },
	{ TEXT("Құдай-ау, анау не?!"), false },
	{ TEXT("Тоқта! Атамын!"), false },
	{ TEXT("Ауылда тәртіп сақта."), false },
	{ TEXT("Мутанттарды көрдің бе?"), false },
	{ TEXT("Түнгі күзет — ең ауыры."), false },
	{ TEXT("Бекет, мұнда тыныш. Қабылдадым."), false },
	{ TEXT("Шығыс жақта бірдеңе жылтырады..."), false },
	{ TEXT("Бір сағаттан кейін ауысамыз."), false },
	{ TEXT("Жолың болсын, инженер."), false },
	{ TEXT("Абай бол, дала қауіпті."), false },
	{ TEXT("Кеніш аумағы. Құжатың бар ма?"), false },
	{ TEXT("Рұқсатсыз қару ұстама."), false },
	{ TEXT("Көмектесіңіз... біз мұнда үш күннен бері..."), false },
	{ TEXT("Ол түнде келеді... алып..."), false },
	{ TEXT("Ақсай полициясы. Тәртіп сақтаңыз."), false },
	{ TEXT("Бандиттерді көрсеңіз — бізге хабарлаңыз."), false },
	{ TEXT("Капитанда сізге жұмыс бар."), false },
	{ TEXT("Түнде жолға жалғыз шықпаңыз."), false },
	{ TEXT("Әскери аймақ. Құжатыңызды дайындаңыз."), false },
	{ TEXT("Майор жұмыс береді — қақпаның жанында."), false },
	{ TEXT("Түнде ұядан бір нәрсе шығады..."), false },
	{ TEXT("Рұқсатсыз ішке кірмеңіз."), false },
	{ TEXT("Тоқта! Бұл әскери аймақ! Кері қайт!"), false },
	{ TEXT("Соңғы ескерту! Аймақтан шық, әйтпесе атамыз!"), false },
	{ TEXT("Атыңдар!"), false },
	{ TEXT("Келіңіз, тауар таза, баға әділ!"), false },
	{ TEXT("Оқ-дәрі керек пе? Менде бар."), false },
	{ TEXT("Сынық металл әкелсеңіз, сатып аламын."), false },
	{ TEXT("Ей, инженер! Тоқта!"), false },
	{ TEXT("Бөлшектерді бер, тірі қаласың!"), false },
	{ TEXT("Жігіттер, мұнда!"), false },
	{ TEXT("бірінші"), true },
	{ TEXT("екінші"), true },
	{ TEXT("үшінші"), true },
	{ TEXT("төртінші"), true },
	{ TEXT("бесінші"), true },
	{ TEXT("алтыншы"), true },
	{ TEXT("жетінші"), true },
	{ TEXT("сегізінші"), true },
	{ TEXT("тоғызыншы"), true },
	{ TEXT("оныншы"), true },
	{ TEXT("он бірінші"), true },
	{ TEXT("он екінші"), true },
	{ TEXT("он үшінші"), true },
	{ TEXT("он төртінші"), true },
	{ TEXT("он бесінші"), true },
	{ TEXT("он алтыншы"), true },
	{ TEXT("он жетінші"), true },
	{ TEXT("он сегізінші"), true },
	{ TEXT("он тоғызыншы"), true },
	{ TEXT("жиырмасыншы"), true },
	{ TEXT("жиырма бірінші"), true },
	{ TEXT("ұңғымада сорғы тоқтады. Бұзылу кезеңі басталды."), true },
	{ TEXT("ұңғымада құбыр жарылды. Бұзылу кезеңі басталды."), true },
	{ TEXT("ұңғымада электр ақауы. Бұзылу кезеңі басталды."), true },
	{ TEXT("ұңғымада қышқыл ағып жатыр. Бұзылу кезеңі басталды."), true },
	{ TEXT("ұңғымада өрт шықты. Бұзылу кезеңі басталды."), true },
	{ TEXT("ұңғымада ерітінді ағып жатыр! Жұмысшылар сәулеленуде."), true },
	{ TEXT("ұңғыма жанып жатыр! Ұңғыма жоғалды."), true },
	{ TEXT("Бригада"), true },
	{ TEXT("ұңғымаға шықты."), true },
	{ TEXT("ұңғыманы жөндеді."), true },
	{ TEXT("ұңғымадағы жұмысшы сәулеленуден қайтыс болды."), true },
	{ TEXT("ұңғымадағы жұмысшы қайтыс болды... денесі мутацияға ұшырады."), true },
	{ TEXT("Қашу."), false },
	{ TEXT("Ұңғымалардың көбі жанып кетті."), false },
	{ TEXT("Жұмысшылардың көбі қаза тапты."), false },
	{ TEXT("Жағдайымыз жақсы, инженер. Тек ұңғымаларды тастап кетпеңіз."), false },
	{ TEXT("Басым айналып тұр... жүрегім айнып жүр."), false },
	{ TEXT("Тұра алмай жатырмын... Көмектесіңізші."), false },
	{ TEXT("...(әрең дем алып жатыр)"), false },
	{ TEXT("Анам Ақсайда күтіп отыр. Оқуымды бітіріп, оған үй салып беремін деп едім..."), false },
	{ TEXT("Шарттар орындалды. Есеп жіберілсін бе?"), false },
	{ TEXT("Құтқару шарттары орындалмаған. Қазір жіберсеңіз, орталық аймақты жабады — «Қашу» соңы."), false },
	{ TEXT("Қаруды жасыр! Рұқсатың жоқ!"), false },
};
